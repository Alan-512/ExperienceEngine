{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "declaration": true,
    "sourceMap": true,
    "types": ["node", "vitest/importMeta"],
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}

